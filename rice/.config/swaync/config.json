{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "notification-window-width": 412,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "transition-time": 180,
  "notification-2fa-action": false,
  "notification-inline-replies": false,
  "notification-action-filter": {
    "open-and-close-only": {
      "use-regex": true,
      "id-matcher": "^(?!default$).+"
    }
  },
  "image-visibility": "when-available",
  "hide-on-action": true,
  "widgets": ["notifications"]
}
